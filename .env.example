# ── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins for CORS (use * only in dev).
# In prod, list every browser origin that calls this API, e.g.:
#   CORS_ORIGINS=https://njakasoa.xyz,https://warzone.njakasoa.xyz
CORS_ORIGINS=*

# ── Database (Postgres) ────────────────────────────────
# Local dev via docker-compose: postgres://core:core@localhost:5432/core_api
DATABASE_URL=postgres://core:core@localhost:5432/core_api

# ── Auth ───────────────────────────────────────────────
# 32+ char secret used to sign JWT access tokens. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-secret-string-min-32
# Access token TTL (seconds) and refresh token TTL (seconds)
ACCESS_TTL=900
REFRESH_TTL=2592000

# ── Rate limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120

# ── Webhooks ───────────────────────────────────────────
# Max delivery attempts before a webhook event is marked failed
WEBHOOK_MAX_ATTEMPTS=5

# ── Text-to-speech (ElevenLabs) ────────────────────────
# Optional. Powers Angano's spoken narration: the AI-written legend is voiced
# during the prep screen and served back by GET /v1/tts/:hash. The feature only
# turns on when BOTH the key and a narrator voice are set — otherwise games stay
# text-only. Never a hard dependency: any failure falls back to text.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Measured on a typical narration line: flash_v2_5 544ms, multilingual_v2 1362ms,
# v3 3572ms. The warm-up runs ~10 lines 4-at-a-time inside a 12s budget, so
# multilingual_v2 fits comfortably and reads far better than flash.
# Keep this the SAME model the front generated its static voice lines with, or the
# narrator subtly changes character between a role reveal and the story.
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice id of the storyteller. Pick a FRENCH voice — the narration is in French,
# and an English-trained voice reads it with a heavy accent. `qCDtdqQv5bdcrgWED5k8`
# (Arthur Martin, language=fr, use_case=narrative_story) is a verified working
# default. List the ones your account can reach with:
#   curl -H "xi-api-key: $KEY" https://api.elevenlabs.io/v2/voices
# Grandpa Storyteller Oxley — le conteur de la légende enregistrée
ELEVENLABS_VOICE_NARRATOR=0dPqNXnhg2bmxQv1WKDp
# Dictionnaire de prononciation malgache — créé et mis à jour depuis le dépôt front
# (`bun run dico:sync`), qui versionne les règles. Absent, les noms sont lus à la
# française ; le serveur le signale au démarrage.
ELEVENLABS_DICT_ID=
ELEVENLABS_DICT_VERSION=
# Voice settings — all optional, omitted ones keep the voice's own defaults.
#   STABILITY  low = expressive and varied, high = flat and consistent
#   STYLE      acting exaggeration; gets unstable past ~0.6
#   SPEED      below 1 is slower and graver (0.7–1.2)
# Audition them first: angano/ `bun scripts/audition-voice.ts sweep stability`.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=

# Upstream timeout, in-memory clip cache ceiling (MB), and the per-room character
# budget that caps what a single game can spend.
TTS_TIMEOUT_MS=12000
TTS_CACHE_MB=64
ANGANO_TTS_CHAR_BUDGET=8000

# ── WebRTC TURN (Cloudflare Realtime) ──────────────────
# Optional. From the Cloudflare dashboard → Realtime → TURN: create a TURN app
# and copy its Token ID + API token. When both are set, POST /v1/turn/credentials
# mints short-lived ICE servers (STUN+TURN) for the browser game; players behind
# symmetric NAT (mobile data / CGNAT) can then connect peer-to-peer. Leave blank
# for STUN-only.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Credential lifetime in seconds (default 24h)
TURN_TTL=86400
